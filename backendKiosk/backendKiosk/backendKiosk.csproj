<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>backendKiosk</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Eagles Nest Restaurant</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.backendkiosk</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#101B2D" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#101B2D" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.6" />
		<PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.6" />
		<PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="2.1.6" />
	</ItemGroup>

	<!-- Modify Mac Catalyst configuration to disable AOT compilation and code signing -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
		<!-- Use RuntimeIdentifiers (plural) to support multiple architectures -->
		<RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>
		<CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
		<EnableCodeSigning>False</EnableCodeSigning>
		<CreatePackage>false</CreatePackage>
		<!-- Disable AOT -->
		<UseInterpreter>True</UseInterpreter>
		<MtouchInterpreter>all</MtouchInterpreter>
		<AOTMode>None</AOTMode>
		<IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\temp</IntermediateOutputPath>
	</PropertyGroup>

	<!-- iOS development optimizations -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Debug'">
		<!-- Use "SdkOnly" linking in Debug mode to speed up builds -->
		<MtouchLink>SdkOnly</MtouchLink>
		<!-- Disable full debug info to speed up build -->
		<DebugType>portable</DebugType>
		<!-- Enable incremental AOT -->
		<MtouchUseLlvm>false</MtouchUseLlvm>
	</PropertyGroup>

	<!-- iOS Simulator specific optimizations -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)'=='ios-arm64-simulator'">
		<!-- Enable interpreter mode for simulator builds -->
		<UseInterpreter>true</UseInterpreter>
		<!-- Skip linking for simulator builds -->
		<MtouchNoSymbolStrip>true</MtouchNoSymbolStrip>
		<!-- Reduce debug information in simulator builds -->
		<MtouchDebug>true</MtouchDebug>
		<MtouchProfiling>false</MtouchProfiling>
	</PropertyGroup>

	<!-- Global development optimizations -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Enable concurrent builds -->
		<BuildInParallel>true</BuildInParallel>
		<!-- Optimize incremental builds -->
		<EnableIncrementalBuild>true</EnableIncrementalBuild>
		<!-- Enable Fast XAML parsing and compilation -->
		<EnableDefaultXamlItems>true</EnableDefaultXamlItems>
		<!-- Set maximum CPU usage -->
		<_MaxCpuCount>8</_MaxCpuCount>
	</PropertyGroup>
	
	<!-- Android optimizations -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Debug'">
		<!-- Disable AAPT during design-time builds -->
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<!-- Skip unnecessary steps during design-time builds -->
		<AndroidDexTool>d8</AndroidDexTool>
		<!-- Enable Fast Deployment -->
		<EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
	</PropertyGroup>

</Project>
