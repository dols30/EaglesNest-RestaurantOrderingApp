<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="backendKiosk.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:backendKiosk"
    xmlns:views="clr-namespace:backendKiosk.Project.Views"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled">

    <!-- Main Navigation Structure -->
    
    <!-- HOME/START FLOW -->
    <ShellContent
        Title="Welcome" 
        ContentTemplate="{DataTemplate views:KioskStartPage}"
        Route="welcome" />
    
    <!-- ORDER FLOW -->
    <ShellContent
        Title="Menu"
        ContentTemplate="{DataTemplate views:MainMenuPage}"
        Route="menu" />
    
    <ShellContent
        Title="Combo Builder"
        ContentTemplate="{DataTemplate views:ComboBuilderPage}"
        Route="combo" />
    
    <ShellContent
        Title="Add Item"
        ContentTemplate="{DataTemplate views:ItemAddPage}"
        Route="itemAdd" />
    
    <ShellContent
        Title="Checkout"
        ContentTemplate="{DataTemplate views:CheckoutView}"
        Route="checkout" />

    <!-- ADMIN FLOW -->
    <ShellContent
        Title="Admin Dashboard"
        ContentTemplate="{DataTemplate views:MenuDashboardPage}"
        Route="dashboard" />
    
    <ShellContent
        Title="Edit Item"
        ContentTemplate="{DataTemplate views:MenuItemEditPage}"
        Route="editItem" />
</Shell>
