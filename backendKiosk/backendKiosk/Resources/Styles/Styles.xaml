<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="Label" x:Key="PageHeading">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style TargetType="Label" x:Key="SectionHeading">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#FFB47A" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="#EF8A3E" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource Line}" /><Setter Property="TextColor" Value="{StaticResource Muted}" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Button" x:Key="DarkSecondaryButton" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BorderColor" Value="{StaticResource NavyLine}" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="TitleColor" Value="{StaticResource Muted}" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style TargetType="SearchBar"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="PlaceholderColor" Value="{StaticResource Muted}" /><Setter Property="CancelButtonColor" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="Border"><Setter Property="Stroke" Value="{StaticResource Line}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 14" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Color" Value="{StaticResource Ink}" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="Switch"><Setter Property="OnColor" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True"><Setter Property="Shell.BackgroundColor" Value="{StaticResource Ink}" /><Setter Property="Shell.ForegroundColor" Value="{StaticResource White}" /><Setter Property="Shell.TitleColor" Value="{StaticResource White}" /></Style>
    <Style TargetType="Border" x:Key="SelectionTile">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource Secondary}" /><Setter Property="Stroke" Value="{StaticResource Primary}" /><Setter Property="StrokeThickness" Value="2" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
</ResourceDictionary>
