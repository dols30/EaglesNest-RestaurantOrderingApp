<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:backendKiosk.Project.Views"
             x:Class="backendKiosk.Project.Views.ComboBuilderPage" Title="Build a Combo">
    <ContentPage.Resources>
        <DataTemplate x:Key="ComboTile" x:DataType="local:ComboItemView"><Border Style="{StaticResource SelectionTile}" WidthRequest="186" Padding="16"><VerticalStackLayout Spacing="10"><Label Text="{Binding Name}" FontSize="18" FontFamily="OpenSansSemibold" /><Label Text="{Binding Price}" TextColor="{StaticResource Muted}" FontSize="15" /></VerticalStackLayout></Border></DataTemplate>
    </ContentPage.Resources>
    <Grid Padding="28" MaximumWidthRequest="1100" HorizontalOptions="Fill" RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <VerticalStackLayout Spacing="6"><Label Text="Build a Combo" Style="{StaticResource PageHeading}" /><Label Text="Three favorites. One great meal. Save 10%." TextColor="{StaticResource Muted}" /></VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" />
                <Label Text="Choose your entree" Style="{StaticResource SectionHeading}" />
                <CollectionView x:Name="collEntreeSelection" SelectionMode="Single" SelectionChanged="SelectEntree" HeightRequest="122" ItemTemplate="{StaticResource ComboTile}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" /></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="No entrees available." Padding="12" /></CollectionView.EmptyView></CollectionView>
                <Label Text="Pick a side" Style="{StaticResource SectionHeading}" />
                <CollectionView x:Name="collSideSelection" SelectionMode="Single" SelectionChanged="SelectSide" HeightRequest="122" ItemTemplate="{StaticResource ComboTile}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" /></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="No sides available." Padding="12" /></CollectionView.EmptyView></CollectionView>
                <Label Text="Add a drink" Style="{StaticResource SectionHeading}" />
                <CollectionView x:Name="collDrinkSelection" SelectionMode="Single" SelectionChanged="SelectDrink" HeightRequest="122" ItemTemplate="{StaticResource ComboTile}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" /></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="No drinks available." Padding="12" /></CollectionView.EmptyView></CollectionView>
                <Label Text="Choose your size" Style="{StaticResource SectionHeading}" />
                <CollectionView x:Name="collSizeSelection" SelectionMode="Single" SelectionChanged="SelectSize" HeightRequest="90">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate><DataTemplate x:DataType="local:SizeTypeView"><Border Style="{StaticResource SelectionTile}" WidthRequest="104" Padding="12"><VerticalStackLayout Spacing="6"><Label Text="{Binding Text}" FontFamily="OpenSansSemibold" /><Label Text="{Binding Rate}" FontSize="12" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><Label Text="Combo total · 10% off" TextColor="{StaticResource Muted}" VerticalOptions="Center" /><Label x:Name="lblCost" Grid.Column="1" Text="Choose 3 items" FontSize="20" FontFamily="OpenSansSemibold" /></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="Cancel" Clicked="CancelComboClicked" Style="{StaticResource SecondaryButton}" /><Button x:Name="AddButton" Grid.Column="1" Text="Add to Order" Clicked="AddComboClicked" IsEnabled="False" /></Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
