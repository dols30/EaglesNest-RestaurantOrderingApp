<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:backendKiosk.Project.Views"
             x:Class="backendKiosk.Project.Views.ItemAddPage" Title="Choose an item">
    <Grid Padding="28" MaximumWidthRequest="1040" HorizontalOptions="Fill" RowDefinitions="Auto,*,Auto" RowSpacing="22">
        <VerticalStackLayout Spacing="6"><Label x:Name="CategoryHeading" Text="Choose an entree" Style="{StaticResource PageHeading}" /><Label Text="Tap a favorite to add it to your meal." TextColor="{StaticResource Muted}" /></VerticalStackLayout>
        <Grid Grid.Row="1">
            <CollectionView x:Name="collItemSelection" SelectionMode="Single" SelectionChanged="SelectItem">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12" /></CollectionView.ItemsLayout>
                <CollectionView.EmptyView><Label Text="No items available in this category yet." Padding="20" TextColor="{StaticResource Muted}" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate><DataTemplate x:DataType="local:ItemSelectView">
                    <Border Style="{StaticResource SelectionTile}"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8"><Label Text="{Binding Name}" FontSize="20" FontFamily="OpenSansSemibold" /><Label Grid.Column="1" Text="{Binding Price}" FontSize="19" FontFamily="OpenSansSemibold" /><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="13" TextColor="{StaticResource Muted}" /></Grid></Border>
                </DataTemplate></CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="16">
            <VerticalStackLayout x:Name="layoutSizeSelectView" IsVisible="False" Spacing="10">
                <Label Text="Choose your size" Style="{StaticResource SectionHeading}" />
                <CollectionView x:Name="collSizeSelection" SelectionMode="Single" SelectionChanged="SelectSize" HeightRequest="88">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate><DataTemplate x:DataType="local:SizeTypeView"><Border Style="{StaticResource SelectionTile}" WidthRequest="104" Padding="12"><VerticalStackLayout Spacing="6"><Label Text="{Binding Text}" FontFamily="OpenSansSemibold" /><Label Text="{Binding Rate}" FontSize="12" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="Cancel" Clicked="CancelClicked" Style="{StaticResource SecondaryButton}" /><Button x:Name="AddButton" Grid.Column="1" Text="Add to Order" Clicked="AddItemClicked" IsEnabled="False" /></Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
